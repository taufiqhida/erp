# ── Konfigurasi untuk deploy Docker (staging/produksi) ──────────────────
# Di server (VPS), salin file ini JADI `.env` PERSIS (nama file harus persis
# ".env", bukan ".env.docker") — docker-compose.yml baca variabelnya dari
# situ:
#   cp .env.docker.example .env
# Lalu isi nilai sungguhan di dalamnya. JANGAN commit hasil salinannya
# (nama ".env" sudah masuk .gitignore). Ini terpisah dari `.env` yang dipakai
# development lokal non-Docker (Laragon) di komputer developer — tidak akan
# saling menimpa karena beda mesin/checkout.

# ── Aplikasi ──────────────────────────────────────────────────────────
APP_NAME="Sedaya Sistem Informasi Developer"
APP_ENV=staging
# WAJIB diisi nilai unik — generate dengan:
#   docker compose run --rm app php artisan key:generate --show
APP_KEY=
APP_DEBUG=false
# Ganti ke domain/IP staging sungguhan (tanpa trailing slash).
APP_URL=http://staging.contoh-domain.com

APP_LOCALE=id
APP_FALLBACK_LOCALE=id

LOG_CHANNEL=stack
LOG_LEVEL=warning

# ── Database ──────────────────────────────────────────────────────────
# WAJIB MySQL 8 (bukan MariaDB, bukan versi MySQL lebih lama) — beberapa
# migrasi project ini pakai REGEXP_SUBSTR & ALTER...MODIFY COLUMN ENUM yang
# cuma didukung MySQL 8+. Lihat memori project_import_kavling_notes.
DB_CONNECTION=mysql
DB_HOST=ecommerce-db
DB_PORT=3306
DB_DATABASE=erp
DB_USERNAME=erp
DB_PASSWORD=GANTI_PASSWORD_INI

# Dibaca container `db` (image mysql:8) — root password TERPISAH dari
# password user aplikasi di atas, jangan disamakan.
MYSQL_ROOT_PASSWORD=GANTI_ROOT_PASSWORD_INI
MYSQL_DATABASE=${DB_DATABASE}
MYSQL_USER=${DB_USERNAME}
MYSQL_PASSWORD=${DB_PASSWORD}

# ── Session / Cache / Queue ──────────────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
# Cookie sesi hanya dikirim lewat HTTPS (aman karena ERP selalu diakses lewat domain HTTPS)
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=public

# ── Migrasi otomatis saat container start ────────────────────────────
# true = aman untuk staging single-container. Kalau nanti scale app jadi
# >1 replika, matikan ini & jalankan migrate manual sekali saja (lihat
# DEPLOY.md) supaya tidak ada 2 container migrate bersamaan.
RUN_MIGRATIONS=true

# ── Mail (opsional — kalau belum ada SMTP, boleh dikosongkan/pakai log) ──
MAIL_MAILER=log

# ── Port di HOST/VPS yang diarahkan ke Nginx dalam container (default 8080
# kalau baris ini dikosongkan/dihapus). Kalau di depan sudah ada reverse
# proxy (Nginx/Caddy di host, atau Cloudflare Tunnel) yang urus HTTPS &
# domain, container ini cukup dengar di port internal seperti 8080 lalu
# di-proxy dari situ — TIDAK perlu container ini langsung pegang port 80/443.
APP_PORT=8083

# Wajib `*` kalau di belakang reverse proxy (Nginx host) supaya URL https benar
TRUSTED_PROXIES=*

# Network Docker milik MySQL yang dipakai bersama (lihat docker-compose.yml)
SHARED_DB_NETWORK=belajarecomerce_ecommerce-network
